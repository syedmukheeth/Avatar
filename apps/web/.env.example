# Public values only. Every NEXT_PUBLIC_* variable ships to the browser:
# never put a secret key, service key or provider key here.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Local: the backend runs on its own port. On Vercel leave unset: it defaults to the
# same-origin /api/backend route defined in vercel.json.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/backend
NEXT_PUBLIC_VOICE_ENABLED=false
