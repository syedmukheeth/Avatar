# Copy to .env for local development. Never commit real values.
ENV=development
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:3000
# Routes are served under this prefix (matches the vercel.json rewrite).
# API_PREFIX=/api/backend

# Supabase (local stack: `pnpm db:start` prints these)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SECRET_KEY=
# Long-running processes (worker, voice): direct or session pooler URL (port 5432).
# Vercel (serverless API): transaction pooler URL (port 6543) with
# DB_STATEMENT_CACHE_SIZE=0 and a small DB_POOL_MAX_SIZE such as 3.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# DB_STATEMENT_CACHE_SIZE=100
# DB_POOL_MAX_SIZE=10

# Providers
GROQ_API_KEY=
GEMINI_API_KEY=
CARTESIA_API_KEY=

# Cloudflare Realtime TURN (required for the voice role when ENV=production)
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=

# Optional overrides (defaults shown)
# VOICE_MAX_CALL_SECS=300
# VOICE_IDLE_TIMEOUT_SECS=120
# VOICE_MAX_SESSIONS=4
# VOICE_RATE_CALLS=5
# VOICE_RATE_WINDOW_SECS=600
# VOICE_DAILY_USER_SECS=1800
# VOICE_TESTER_USER_IDS=
# CHAT_RATE_MESSAGES=30
# CHAT_RATE_WINDOW_SECS=300
